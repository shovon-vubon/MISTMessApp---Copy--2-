# Copy this file to ".env" and fill in the values.

# Port the server listens on (most hosts set PORT automatically).
PORT=8080

# Comma-separated list of allowed origins for CORS.
# For a Capacitor Android app the WebView origin is https://localhost.
# Use * while testing, then lock it down.
CORS_ORIGIN=*

# Firebase Admin credentials.
# Option A (recommended for hosting): paste the FULL service account JSON on a
# single line, or its base64 encoding, into FIREBASE_SERVICE_ACCOUNT.
# Option B (local dev): leave this blank and place serviceAccount.json in /backend.
FIREBASE_SERVICE_ACCOUNT=
